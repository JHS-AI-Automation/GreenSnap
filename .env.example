# Supabase - maak een gratis project aan op https://supabase.com
# Ga naar Settings > API om deze waarden te vinden
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-key-hier
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key-hier

# Telegram Bot - maak een bot via @BotFather in Telegram
